# ============================================================
# Opportunity OS — environment variables TEMPLATE
# This file is safe to commit. It contains NO real secrets.
# Copy to app/.env.local and fill real values there (gitignored).
# ============================================================

# ---------- Supabase ----------
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
# Service role key — SERVER ONLY, never expose to browser.
# Used by n8n ingestion + server-side admin tasks. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ---------- AI providers ----------
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...your-gemini-key...
# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_...your-groq-key...

# ---------- Email (Resend) ----------
# https://resend.com/api-keys
RESEND_API_KEY=re_...your-resend-key...
# The "from" address. During dev you can use Resend's onboarding address.
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---------- Telegram bot ----------
# From @BotFather when you ran /newbot
TELEGRAM_BOT_TOKEN=123456789:ABC...your-bot-token...
# (Optional) Single chat_id to push digests to. For personal use, paste your
# own user ID here. Get it by messaging your bot once, then visiting:
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# and copying the "chat":{"id":...} number from the most recent update.
TELEGRAM_DEFAULT_CHAT_ID=

# ---------- App ----------
# Public URL of the deployed app. In dev, use http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to authenticate n8n → Next.js API calls.
# Generate with: openssl rand -hex 32  (or any long random string, 32+ chars)
INGEST_SHARED_SECRET=replace-with-long-random-string
# Secret for Vercel Cron auth header.
CRON_SECRET=replace-with-long-random-string

# ---------- Payments (Dodo Payments) ----------
# Get from: https://app.dodopayments.com/developer or https://test.dodopayments.com
DODO_PAYMENTS_API_KEY=test_...
DODO_PAYMENTS_MODE=test_mode # 'test_mode' for sandbox, 'live_mode' for live payments
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# Pre-created product IDs from Dodo Dashboard:
DODO_PRODUCT_PRO_30D=pdt_0Nm5W5I244ZWrOS1nKZoT
DODO_PRODUCT_PRO_90D=pdt_0Nm5WQl2Nmshe2jz2Any2
DODO_PRODUCT_PRO_365D=pdt_0Nm5WbDdKzHom69blkpO5




