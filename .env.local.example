# ============================================================
# Opportunity OS — Environment Variables Template
#
# SECURITY NOTICE:
# - This file is safe to commit. It contains NO real secrets.
# - Copy this file to `app/.env.local` for local development (gitignored).
# - NEVER commit real credentials, tokens, or private keys to git.
# - If any secret was ever previously exposed, ROTATE IT IMMEDIATELY.
# ============================================================

# ---------- Supabase ----------
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Service role key — SERVER-SIDE ONLY, NEVER EXPOSE TO CLIENT/BROWSER!
# Bypasses Row Level Security (RLS) for server-side ingestion and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ---------- AI Providers ----------
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...your-gemini-key...
# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_...your-groq-key...

# ---------- Email (Resend) ----------
# https://resend.com/api-keys
RESEND_API_KEY=re_...your-resend-key...
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---------- Telegram Bot (Alerts & Digests) ----------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABC...your-bot-token...
TELEGRAM_DEFAULT_CHAT_ID=

# ---------- App & Security Secrets ----------
# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for authenticating ingestion pipelines (n8n -> Next.js)
# Generate with: openssl rand -hex 32
INGEST_SHARED_SECRET=replace-with-long-random-string-at-least-32-chars

# Secret for Vercel Cron authentication (Authorization: Bearer <CRON_SECRET>)
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-long-random-string-at-least-32-chars

# ---------- Payments (Dodo Payments) ----------
# Get from: https://app.dodopayments.com/developer
DODO_PAYMENTS_API_KEY=test_...
DODO_PAYMENTS_MODE=test_mode # 'test_mode' for sandbox, 'live_mode' for live production
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...

# Product IDs from Dodo Dashboard
DODO_PRODUCT_PRO_30D=pdt_...
DODO_PRODUCT_PRO_90D=pdt_...
DODO_PRODUCT_PRO_365D=pdt_...

# ---------- Recruiter Intelligence (Optional) ----------
# Hunter.io API key for recruiter radar: https://hunter.io
HUNTER_API_KEY=
