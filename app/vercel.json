{
  "crons": [
    {
      "path": "/api/cron/daily-digest",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/process-raw",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}
