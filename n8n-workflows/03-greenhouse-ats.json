            { "name": "source_name", "value": "={{ 'Greenhouse: ' + $('Loop Over Items').item.json.company }}" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1776, -64],
      "id": "30bb6b3f-1c91-4e1a-9c66-2b8a23d2a409",
      "name": "Upsert Opportunity"
