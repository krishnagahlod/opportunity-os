    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/ai/extract",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Ingest-Secret", "value": "REPLACE_WITH_YOUR_INGEST_SHARED_SECRET" },
            { "name": "Content-Type",    "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text",        "value": "={{ ($('Loop Over Items').item.json.company + ' is hiring: ' + $('Loop Over Items').item.json.title + '\\nLocation: ' + ($('Loop Over Items').item.json.location || 'unspecified') + '\\n\\n' + ($('Loop Over Items').item.json.content || '')).slice(0, 4000) }}" },
            { "name": "source_url",  "value": "={{ $('Loop Over Items').item.json.link }}" },
            { "name": "source_name", "value": "={{ 'Greenhouse: ' + $('Loop Over Items').item.json.company }}" },
            { "name": "hint",        "value": "={{ 'Greenhouse ATS listing — full-time/intern role at ' + $('Loop Over Items').item.json.company }}" }
          ]
        },
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1536, -64],
      "id": "30bb6b3f-1c91-4e1a-9c66-2b8a23d2a408",
