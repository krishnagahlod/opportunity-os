{
  "name": "Greenhouse — Multi-company ATS",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "id": "30bb6b3f-1c91-4e1a-9c66-2b8a23d2a401",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "// === Companies to scrape via Greenhouse Job Board API ===\n// Edit this list to add/remove coverage. Each slug must match the\n// company's Greenhouse board token (found in their careers page URL).\n// Verify a slug by hitting https://boards-api.greenhouse.io/v1/boards/<slug>/jobs\n// in a browser — should return JSON with a `jobs` array.\nconst COMPANIES = [\n  { slug: 'anthropic',  displayName: 'Anthropic' },\n  { slug: 'figma',      displayName: 'Figma' },\n  { slug: 'vercel',     displayName: 'Vercel' },\n  { slug: 'discord',    displayName: 'Discord' },\n  { slug: 'airbnb',     displayName: 'Airbnb' },\n  { slug: 'postman',    displayName: 'Postman' },\n  { slug: 'cloudflare', displayName: 'Cloudflare' },\n  { slug: 'stripe',     displayName: 'Stripe' },\n  { slug: 'webflow',    displayName: 'Webflow' }\n];\n\n// Cap per company — 9 companies × 5 = 45 jobs max per fire; Limit node trims further.\nconst PER_COMPANY_LIMIT = 5;\n\nconst out = [];\nconst errors = [];\n\nfor (const c of COMPANIES) {\n  try {\n    // Use n8n's helper — native fetch isn't reliably available in every\n    // Code-node sandbox version; this.helpers.httpRequest always works.\n    const data = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `https://boards-api.greenhouse.io/v1/boards/${c.slug}/jobs?content=true`,\n      json: true,\n    });\n    const jobs = Array.isArray(data && data.jobs) ? data.jobs.slice(0, PER_COMPANY_LIMIT) : [];\n    for (const j of jobs) {\n      out.push({\n        json: {\n          title: j.title,\n          link: j.absolute_url,\n          content: j.content || '',\n          location: (j.location && j.location.name) || '',\n          company: c.displayName,\n          companySlug: c.slug,\n          updated_at: j.updated_at || ''\n        }\n      });\n    }\n  } catch (e) {\n    errors.push(`${c.slug}: ${(e && e.message) || e}`);\n  }\n}\n\n// Fail loud rather than silently producing 0 items.\nif (out.length === 0) {\n  throw new Error('Greenhouse fetch returned 0 jobs. Errors: ' + (errors.join(' | ') || 'none'));\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [208, 0],
      "id": "30bb6b3f-1c91-4e1a-9c66-2b8a23d2a402",
      "name": "Fetch Greenhouse Jobs"
    },
    {
      "parameters": { "maxItems": 30 },
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [416, 0],
      "id": "30bb6b3f-1c91-4e1a-9c66-2b8a23d2a403",
      "name": "Limit"
    },
    {
      "parameters": { "options": { "reset": false } },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [624, 0],
      "id": "30bb6b3f-1c91-4e1a-9c66-2b8a23d2a404",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
